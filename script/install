#!/bin/zsh
# Builds from source and installs Consolidatex.app plus the `acc` CLI. Safe to re-run;
# re-running after `git pull` is how you update a source install.
set -eu
cd ${0:A:h:h}

bin_dir=${ACC_BIN_DIR:-$HOME/.local/bin}
app="${ACC_APP_DIR:-$HOME/Applications}/Consolidatex.app"

swift build -c release --product acc
swift build -c release --product Consolidatex
release=$(swift build -c release --show-bin-path)
version=$($release/acc version | cut -d' ' -f2)

staging=$(mktemp -d "${TMPDIR:-/tmp}/consolidatex.XXXXXX")/Consolidatex.app
script/bundle $release "$staging" $version

was_running=0
pkill -x Consolidatex && was_running=1 || true
rm -rf "$app"
mkdir -p "${app:h}" $bin_dir
mv "$staging" "$app"
ln -sf "$app/Contents/Resources/acc" $bin_dir/acc

print "installed Consolidatex $version"
print "  $app"
print "  $bin_dir/acc -> app"
(( was_running )) && { open "$app" 2>/dev/null || print "start it with: open \"$app\""; }
print "\nFirst time? Run: acc setup"
