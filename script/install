#!/bin/zsh
# Builds from source and installs Consolidatex.app plus the `acc` CLI; on Linux, the CLI alone.
# Safe to re-run; re-running after `git pull` is how you update a source install.
set -eu
cd ${0:A:h:h}

bin_dir=${ACC_BIN_DIR:-$HOME/.local/bin}

if [[ $OSTYPE == linux* ]]; then
  # Swift's runtime is linked in, so acc keeps working when the toolchain is updated or removed.
  swift build -c release --static-swift-stdlib --product acc
  mkdir -p $bin_dir
  install -m 755 "$(swift build -c release --static-swift-stdlib --show-bin-path)/acc" $bin_dir/acc
  print "installed $($bin_dir/acc version)"
  print "  $bin_dir/acc"
  print "\nFirst time? Run: acc setup"
  exit
fi
app="${ACC_APP_DIR:-$HOME/Applications}/Consolidatex.app"

source script/toolchain
swift build -c release --product acc
swift build -c release --product Consolidatex
release=$(swift build -c release --show-bin-path)
version=$($release/acc version | cut -d' ' -f2)

staging=$(mktemp -d "${TMPDIR:-/tmp}/consolidatex.XXXXXX")/Consolidatex.app
script/bundle $release "$staging" $version

was_running=0
pkill -x Consolidatex && was_running=1 || true
# pkill doesn't wait, and `open` would bring the quitting app forward instead of starting the new one.
for _ in {1..50}; do pgrep -x Consolidatex >/dev/null || break; sleep 0.1; done
rm -rf "$app"
mkdir -p "${app:h}" $bin_dir
mv "$staging" "$app"
ln -sf "$app/Contents/MacOS/acc" $bin_dir/acc

print "installed Consolidatex $version"
print "  $app"
print "  $bin_dir/acc -> app"
(( was_running )) && { open "$app" 2>/dev/null || print "start it with: open \"$app\""; }
print "\nFirst time? Run: acc setup"
