#!/bin/zsh
# Unit tests (AccCore) then the black-box CLI + shell wrapper tests.
set -eu -o pipefail
cd ${0:A:h:h}

build_flags=() testing_flags=()
if [[ $OSTYPE == darwin* ]]; then
  source script/toolchain
  dev=$clt/Library/Developer
fi

# Command Line Tools ship swift-testing outside the default search path, and SwiftPM's newer build
# system doesn't find their testing macros, so they build with the native one. Xcode needs neither.
if [[ $OSTYPE == darwin* && $(xcode-select -p) == $clt && -d $dev/Frameworks/Testing.framework ]]; then
  build_flags=(--build-system native)
  testing_flags=(-Xswiftc -F$dev/Frameworks -Xlinker -F$dev/Frameworks
    -Xlinker -rpath -Xlinker $dev/Frameworks -Xlinker -rpath -Xlinker $dev/usr/lib)
fi

swift build $build_flags
# Every failing test and issue, then the totals: a passing run prints one line.
swift test $build_flags $testing_flags 2>&1 | grep -E 'recorded an issue|failed|error|Test run with'
ACC_BIN=$(swift build $build_flags --show-bin-path)/acc zsh Tests/e2e.sh
